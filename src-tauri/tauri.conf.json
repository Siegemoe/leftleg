{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leftleg",
  "version": "0.4.0",
  "identifier": "dev.leftleg.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Leftleg",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: asset: http://asset.localhost https:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0Q0UwQ0U1RUZGMUYxRDQKUldUVThmSHY1UXpPeEh6dWd0eWtSRWZVLzRLYlJxRlVWZHNnRVB5Vlk0ci9tTlJBSVB1WDBCbmcK",
      "endpoints": ["https://github.com/Siegemoe/leftleg/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
